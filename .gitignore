# Environments and tooling
.venv/
__pycache__/
*.py[cod]
.idea/
.vscode/
.DS_Store
Thumbs.db

# Build artifacts of the path dependency (created by poetry/pip install)
packages/anatomy/build/
packages/anatomy/*.egg-info/
packages/anatomy/examples/anatomy.bin

# Generated by the tools (regenerate with tools/run_all_tier1.py)
outputs/*
!outputs/.gitkeep

# Heavy inputs, obtained from the Zenodo archive (see Models/README.md), never committed
Models/*
!Models/README.md
Results/Updated CPI 3/anatomy_h*_upd.bin
Results/Updated CPI 3/ishapley_h*_upd.bin
revision/mas_referee_response/outputs/insample_gpbsv_v5/_window_cache_*/

# Run-time noise of the in-sample GPBSV pipeline
revision/mas_referee_response/outputs/insample_gpbsv_v5/*.log
revision/mas_referee_response/outputs/insample_gpbsv_v5/*.out
!revision/mas_referee_response/outputs/insample_gpbsv_v5/pipeline_master.log
revision/mas_referee_response/outputs/insample_gpbsv_v5/MAS_h*_FINISHED.txt
revision/mas_referee_response/outputs/insample_gpbsv_v5/pipeline_DONE.txt
revision/mas_referee_response/outputs/insample_gpbsv_v5/pipeline.lock
revision/mas_referee_response/outputs/insample_gpbsv_v5/.pushed_*
